    {
      "parameters": {
        "method": "POST",
        "url": "https://your-store.myshopify.com/admin/api/2025-07/products.json",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "shopifyAccessTokenApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{\n  {\n    \"product\": {\n      \"title\": $json.Title,\n      \"body_html\": $json.Description,\n      \"status\": \"active\",\n      \"variants\": [\n        {\n          \"price\": String($json.SalesPrice),\n          \"sku\": $json.SKU\n        }\n      ],\n      \"images\": $json.images.map((item, index) => ({\n        \"attachment\": item.data,\n        \"filename\": `image${index + 1}.png`\n      }))\n    }\n  }\n}}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true
            }
          }
        }
